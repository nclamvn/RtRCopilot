{
  "name": "rtr-copilot-v2",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "lint": "pnpm --filter @rtr/web lint",
    "typecheck": "pnpm --filter @rtr/web typecheck",
    "build": "pnpm --filter @rtr/web build",
    "test": "pnpm --filter @rtr/web test",
    "test:browser": "pnpm --filter @rtr/web test:browser",
    "test:browser:ai-surrogate": "pnpm --filter @rtr/web test:browser:ai-surrogate",
    "verify:web": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "workspace:build": "pnpm --filter @agent-workspace/web build",
    "workspace:typecheck": "pnpm --filter @agent-workspace/web typecheck",
    "workspace:audit": "pnpm --filter @agent-workspace/web audit:graph"
  }
}
