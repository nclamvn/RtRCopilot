# =============================================================================
# RtR Copilot V2 — environment template
#
# SECRET CATALOG (TIP-012 AC-03). Every value tagged [MUST-CHANGE] below is a
# known development default. With APP_ENV=production the backend REFUSES TO
# START while any of them (or any value from the known-default list in
# apps/backend/src/rtr_copilot/config.py — KNOWN_DEFAULT_SECRETS) is still in
# use. Inject real secrets via a root-owned env file or docker secrets — see
# docs/ingress-hardening.md for the procedure. Never commit a filled .env.
# =============================================================================

POSTGRES_DB=rtr_copilot
POSTGRES_USER=rtr_owner
# [MUST-CHANGE] secret · postgres owner password (also embedded in MIGRATION_DSN)
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_RUNTIME_USER=rtr_app
# [MUST-CHANGE] secret · postgres runtime password (also embedded in POSTGRES_DSN)
POSTGRES_RUNTIME_PASSWORD=change-this-runtime-password
# [MUST-CHANGE] secret · must embed the real POSTGRES_PASSWORD
MIGRATION_DSN=postgresql://rtr_owner:change-this-local-password@postgres:5432/rtr_copilot
# [MUST-CHANGE] secret · must embed the real POSTGRES_RUNTIME_PASSWORD
POSTGRES_DSN=postgresql://rtr_app:change-this-runtime-password@postgres:5432/rtr_copilot
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
# [MUST-CHANGE] credential · object storage access key
S3_ACCESS_KEY=rtr-local
# [MUST-CHANGE] secret · object storage secret key
S3_SECRET_KEY=change-this-local-secret
S3_BUCKET=rtr-copilot
API_INTERNAL_URL=http://api:8000
API_PORT=8000
WEB_PORT=3000
MINIO_CONSOLE_PORT=9001
LOG_LEVEL=INFO
# Git revision injected by CI/deploy. Local Make targets derive this value.
RTR_BUILD_SHA=development
APP_ENV=development
# [MUST-CHANGE for production] must be the https:// ingress origin
PUBLIC_BASE_URL=http://127.0.0.1:3000
# [MUST-CHANGE for production] real OIDC issuer (https:// required)
OIDC_ISSUER=
# [MUST-CHANGE for production] real OIDC client id
OIDC_CLIENT_ID=
# [MUST-CHANGE for production] secret · real OIDC client secret
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_DOMAINS=rtrobotics.com,rtrobotics.me
OIDC_GROUP_MAPPING={}
# [MUST-CHANGE for production] must be false (production refuses true)
DEV_OIDC_ENABLED=true
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_NAME=rtr_session
# Session cookie Secure attribute. Empty = derived: always on in production,
# on in any environment whose PUBLIC_BASE_URL is https (e.g. hardened profile).
# production refuses an explicit false.
SESSION_COOKIE_SECURE=
EXPECTED_SCHEMA_REVISION=0014_document_outbox_repair
SOT_STAGING_ROOT=/tmp/rtr-sot-staging
RESEARCH_STAGING_ROOT=/tmp/rtr-research-staging
# [MUST-CHANGE] secret · dedicated random value, >=32 bytes; the placeholder
# below is itself on the known-default refusal list
SOT_SIGNING_SECRET=replace-with-a-dedicated-random-secret-at-least-32-bytes
SOT_ALLOW_CLAIM_AS_APPROVED=false
# TIP-014RE — real semantic embeddings (closes TIP-014 AC-2).
# "offline" = deterministic hash stub (default, no export). "openai" exports
# corpus text at reindex time and the user question per ask; it REQUIRES
# OPENAI_API_KEY plus "internal" in RAG_EXTERNAL_CLASSIFICATION_ALLOWLIST —
# startup fails loudly on half-configured intent instead of downgrading.
# After switching providers, re-embed the active corpus:
#   docker compose exec api python -m rtr_copilot.commands.reembed_corpus
RAG_EMBEDDING_PROVIDER=offline
RAG_EMBEDDING_DIMENSION=1536
RAG_EMBEDDING_MODEL=rtr-offline-hash-embedding
RAG_EMBEDDING_VERSION=1
RAG_EMBEDDING_OPENAI_MODEL=text-embedding-3-small
RAG_EMBEDDING_TIMEOUT_SECONDS=8
RAG_CHUNK_MAX_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=120
RAG_QUERY_MAX_BYTES=4096
RAG_CANDIDATE_LIMIT=200
RAG_METADATA_SCAN_LIMIT=5000
RAG_METADATA_PAGE_SIZE=1000
RAG_RETRIEVAL_TIMEOUT_MS=2000
RAG_TOP_K=5
RAG_ANSWER_CANDIDATE_K=12
# Ordinary questions keep the 12-record prompt budget. Governed profiles and
# collections may expand only to this ceiling when their authority contract is
# larger, avoiding silent loss of a required facet/member definition.
RAG_AUTHORITY_CANDIDATE_K=20
RAG_MIN_VECTOR_SCORE=0.15
RAG_EVIDENCE_MAX_BYTES=16000
RAG_ANSWER_MAX_CHARS=12000
RAG_PROVIDER_TIMEOUT_SECONDS=120
RAG_PROVIDER_MODE=local
RAG_EXTERNAL_CLASSIFICATION_ALLOWLIST=
RAG_REWRITE_ENABLED=true
RAG_ONTOLOGY_PATH=
RAG_QUERY_CANDIDATE_LIMIT=16
# External rewrite is fail-closed unless "internal" is explicitly present in
# RAG_EXTERNAL_CLASSIFICATION_ALLOWLIST. Keep credentials only in local secrets.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RAG_REWRITE_ANTHROPIC_MODEL=claude-3-5-haiku-latest
RAG_REWRITE_OPENAI_MODEL=gpt-5.6-sol
RAG_REWRITE_TIMEOUT_SECONDS=20
RAG_ANSWER_LLM_REQUIRED=true
RAG_ANSWER_OPENAI_MODEL=gpt-5.6-sol
# Optional Anthropic fallback; set an approved current model explicitly.
RAG_ANSWER_ANTHROPIC_MODEL=
RAG_ANSWER_REASONING_EFFORT=high
RAG_ANSWER_ROUTINE_REASONING_EFFORT=low
RAG_REVIEW_REASONING_EFFORT=low
RAG_REVIEW_MAX_OUTPUT_TOKENS=256
RAG_ANSWER_TIMEOUT_SECONDS=45
RAG_ANSWER_MAX_OUTPUT_TOKENS=4096
RAG_REVIEW_MODE=on_demand

# Enterprise connector canary (disabled until registry lifecycle is enabled).
RTR_CONNECTOR_APPROVED_HOSTS=
RTR_CRM_CONNECTOR_BASE_URL=
RTR_CRM_CONNECTOR_TOKEN=
RAG_EXTERNAL_ENDPOINT_POLICY=
RAG_EXTERNAL_CREDENTIAL_SOURCE=
RAG_GAP_ROUTING_KEY=curator:sot
MAINTENANCE_MODE=false
RETENTION_POLICY_JSON=
BACKUP_DESTINATION=

# --- TLS ingress (TIP-012, hardened profile: make hardened-up) --------------
# Hostname the ingress terminates TLS for; must resolve to the docker host
# (local: add "127.0.0.1 rtr.local" to /etc/hosts).
INGRESS_HOST=rtr.local
# Explicit host-interface bind. Keep 127.0.0.1 for local drills; production
# must choose the reviewed LAN/VPN/public interface and is validated as an IP.
INGRESS_BIND_ADDRESS=127.0.0.1
INGRESS_HTTP_PORT=80
INGRESS_HTTPS_PORT=443
# HSTS max-age seconds. 604800 (7 days) locally; raise to >=31536000 with real
# certificates in production.
INGRESS_HSTS_MAX_AGE=604800
# "internal" = Caddy local CA (self-signed, dev). Real certificates (quotes
# required):
#   INGRESS_TLS_MODE="/certs/fullchain.pem /certs/privkey.pem"
# with the files placed in INGRESS_CERTS_DIR (see docs/ingress-hardening.md).
INGRESS_TLS_MODE=internal
INGRESS_CERTS_DIR=./infra/ingress/certs
# Ingress request-body caps (TIP-012 Task 2, AC-04). Keep in sync with the
# app-layer typed-413 limits below: INGRESS_MAX_BODY == LIMITS_MAX_BODY_BYTES
# and INGRESS_MAX_UPLOAD == INGESTION_MAX_UPLOAD_BYTES (Caddy size syntax).
INGRESS_MAX_BODY=1MiB
INGRESS_MAX_UPLOAD=50MiB

# --- App-layer quotas / limits / resilience (TIP-012 Task 2, D-012-03) -------
# Rate limiting, body size and the circuit breaker are deploy-time knobs
# enforced in the API middleware (per subject AND per client IP). Cost budgets
# and job concurrency caps are admin-editable governance settings instead (keys
# limits.budget.* and limits.jobs.*, adjusted via /api/v1/admin/settings).
LIMITS_ENABLED=true
LIMITS_RATE_WINDOW_SECONDS=60
LIMITS_RATE_AUTH_MAX=20
LIMITS_RATE_ASK_MAX=30
LIMITS_RATE_UPLOAD_MAX=20
LIMITS_RATE_RENDER_MAX=30
LIMITS_RATE_ADMIN_MAX=60
LIMITS_RATE_DEFAULT_READ_MAX=120
# Non-upload JSON body cap (typed 413); uploads use INGESTION_MAX_UPLOAD_BYTES.
LIMITS_MAX_BODY_BYTES=1048576
LIMITS_BREAKER_FAILURE_THRESHOLD=5
LIMITS_BREAKER_COOLDOWN_SECONDS=30
LIMITS_QUEUE_RETRY_AFTER_SECONDS=15

# TIP-012 Task 3 — observability. The api serves /metrics on its app port
# (8000, internal only, never via the ingress); the worker serves the
# Prometheus registry on this dedicated internal port. Scraped on the compose
# network per infra/observability/prometheus.yml; not published to the host.
WORKER_METRICS_PORT=9100
