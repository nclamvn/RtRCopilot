SOT_SIGNING_SECRET=replace-with-a-dedicated-random-secret-at-least-32-bytes
SOT_ALLOW_CLAIM_AS_APPROVED=false
RAG_EMBEDDING_DIMENSION=64
RAG_EMBEDDING_MODEL=rtr-offline-hash-embedding
