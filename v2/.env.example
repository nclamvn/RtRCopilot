API_INTERNAL_URL=http://api:8000
API_PORT=8000
WEB_PORT=3000
MINIO_CONSOLE_PORT=9001
LOG_LEVEL=INFO
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:3000
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_DOMAINS=rtrobotics.com,rtrobotics.me
OIDC_GROUP_MAPPING={}
DEV_OIDC_ENABLED=true
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_NAME=rtr_session
EXPECTED_SCHEMA_REVISION=0007_hybrid_rag_grounded_answers
