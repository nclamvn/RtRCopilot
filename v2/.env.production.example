# RtR Copilot production configuration contract (TIP-035.18)
#
# Copy with `make production-config-init`, replace every __SET_*__ token, and
# run `make production-config-check`. Never commit `.env.production`.
# Values must be fully materialized: shell interpolation and command
# substitution are rejected. The checker never prints secret values.

POSTGRES_DB=rtr_copilot
POSTGRES_USER=rtr_owner
POSTGRES_PASSWORD=__SET_UNIQUE_OWNER_PASSWORD__
POSTGRES_RUNTIME_USER=rtr_app
POSTGRES_RUNTIME_PASSWORD=__SET_UNIQUE_RUNTIME_PASSWORD__
MIGRATION_DSN=postgresql://rtr_owner:__SET_UNIQUE_OWNER_PASSWORD__@postgres:5432/rtr_copilot
POSTGRES_DSN=postgresql://rtr_app:__SET_UNIQUE_RUNTIME_PASSWORD__@postgres:5432/rtr_copilot
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=__SET_UNIQUE_S3_ACCESS_KEY__
S3_SECRET_KEY=__SET_UNIQUE_S3_SECRET_KEY__
S3_BUCKET=rtr-copilot
API_INTERNAL_URL=http://api:8000
LOG_LEVEL=INFO

APP_ENV=production
RTR_BUILD_SHA=__SET_EXACT_CANDIDATE_SHA__
PUBLIC_BASE_URL=https://copilot.example.invalid
OIDC_ISSUER=https://identity.example.invalid/tenant/v2.0
OIDC_CLIENT_ID=__SET_OIDC_CLIENT_ID__
OIDC_CLIENT_SECRET=__SET_UNIQUE_OIDC_CLIENT_SECRET__
OIDC_ALLOWED_DOMAINS=__SET_CORPORATE_EMAIL_DOMAIN__
# Map provider group IDs to RtR roles/scopes. Empty object keeps every valid
# corporate identity at the default staff role; add reviewed rules as needed.
OIDC_GROUP_MAPPING={}
DEV_OIDC_ENABLED=false
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_NAME=rtr_session
SESSION_COOKIE_SECURE=true

EXPECTED_SCHEMA_REVISION=0014_document_outbox_repair
SOT_STAGING_ROOT=/tmp/rtr-sot-staging
RESEARCH_STAGING_ROOT=/tmp/rtr-research-staging
SOT_SIGNING_SECRET=__SET_UNIQUE_SOT_SIGNING_SECRET_MIN_32_BYTES__
SOT_ALLOW_CLAIM_AS_APPROVED=false

# Quality-first grounded answering. The production checker requires the
# existing approved internal-data policy and a real provider credential.
RAG_PROVIDER_MODE=external
RAG_ANSWER_LLM_REQUIRED=true
RAG_EMBEDDING_PROVIDER=openai
RAG_EXTERNAL_CLASSIFICATION_ALLOWLIST=internal
RAG_EXTERNAL_ENDPOINT_POLICY=__SET_APPROVED_ENDPOINT_POLICY_ID__
RAG_EXTERNAL_CREDENTIAL_SOURCE=__SET_SECRET_MANAGER_REFERENCE__
OPENAI_API_KEY=__SET_OPENAI_API_KEY__
ANTHROPIC_API_KEY=
RAG_EXPOSE_DECISION_DIAGNOSTICS=false
RAG_REWRITE_ENABLED=true
RAG_REVIEW_MODE=on_demand

# Enterprise connectors remain disabled until separately governed and
# activated. Non-empty values intentionally block this release gate.
RTR_CONNECTOR_APPROVED_HOSTS=
RTR_CRM_CONNECTOR_BASE_URL=
RTR_CRM_CONNECTOR_TOKEN=

MAINTENANCE_MODE=false
BACKUP_DESTINATION=__SET_ENCRYPTED_BACKUP_DESTINATION__

# Real certificate files must exist under this host directory as
# fullchain.pem and privkey.pem. The private key and env file must be mode 600.
INGRESS_HOST=copilot.example.invalid
INGRESS_BIND_ADDRESS=127.0.0.1
INGRESS_HTTP_PORT=80
INGRESS_HTTPS_PORT=443
INGRESS_HSTS_MAX_AGE=31536000
INGRESS_TLS_MODE="/certs/fullchain.pem /certs/privkey.pem"
INGRESS_CERTS_DIR=./infra/ingress/certs
INGRESS_MAX_BODY=1MiB
INGRESS_MAX_UPLOAD=50MiB

LIMITS_ENABLED=true
LIMITS_RATE_WINDOW_SECONDS=60
LIMITS_RATE_AUTH_MAX=20
LIMITS_RATE_ASK_MAX=30
LIMITS_RATE_UPLOAD_MAX=20
LIMITS_RATE_RENDER_MAX=30
LIMITS_RATE_ADMIN_MAX=60
LIMITS_RATE_DEFAULT_READ_MAX=120
LIMITS_MAX_BODY_BYTES=1048576
LIMITS_BREAKER_FAILURE_THRESHOLD=5
LIMITS_BREAKER_COOLDOWN_SECONDS=30
LIMITS_QUEUE_RETRY_AFTER_SECONDS=15
WORKER_METRICS_PORT=9100
