# RtR Copilot local-demo overlay (safe template; contains no runtime secret).
#
# Normal setup:
#   cp .env.example .env
#   scripts/local-demo.sh --kernel-root /path/to/kernel-real
#
# local-demo.sh creates the ignored `.env.demo` from `.env`, generates a random
# SOT signing secret on first run and reuses it on later runs. The values below
# document the non-secret overlay only; do not use the placeholder as a key.
APP_ENV=development
DEV_OIDC_ENABLED=true
SESSION_COOKIE_SECURE=false
EXPECTED_SCHEMA_REVISION=0010_file_retrieval
SOT_SIGNING_SECRET=generated-locally-do-not-commit
SOT_STAGING_ROOT=/tmp/rtr-sot-staging
RAG_PROVIDER_MODE=local
RTR_BUILD_SHA=development
