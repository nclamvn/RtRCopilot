# RtR Copilot local-demo overlay (safe template; contains no runtime secret).
#
# Normal setup:
#   cp .env.example .env
#   scripts/local-demo.sh --kernel-root /path/to/kernel-real
#
# local-demo.sh creates the ignored `.env.demo` from `.env`, generates a random
# SOT signing secret on first run and reuses it on later runs. The values below
# document the non-secret overlay only; do not use the placeholder as a key.
APP_ENV=development
DEV_OIDC_ENABLED=true
SESSION_COOKIE_SECURE=false
EXPECTED_SCHEMA_REVISION=0011_ingestion_pub_deferred
SOT_SIGNING_SECRET=generated-locally-do-not-commit
SOT_STAGING_ROOT=/tmp/rtr-sot-staging
RAG_PROVIDER_MODE=local
RAG_EXTERNAL_CLASSIFICATION_ALLOWLIST=
RAG_REWRITE_ENABLED=false
# To export internal questions for rewrite, explicitly allow "internal" above
# and provide credentials only in the ignored .env.demo file.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RAG_REWRITE_ANTHROPIC_MODEL=claude-3-5-haiku-latest
RAG_REWRITE_OPENAI_MODEL=gpt-4o-mini
RAG_REWRITE_TIMEOUT_SECONDS=4
RTR_BUILD_SHA=development
# TIP-014RE real embeddings: set RAG_EMBEDDING_PROVIDER=openai (requires
# OPENAI_API_KEY above AND "internal" in RAG_EXTERNAL_CLASSIFICATION_ALLOWLIST),
# then re-embed once: docker compose exec api \
#   python -m rtr_copilot.commands.reembed_corpus
RAG_EMBEDDING_PROVIDER=offline
