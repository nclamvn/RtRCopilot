{
  "name": "@agent-workspace/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 WORKSPACE_UI_ENABLED=1 next dev --hostname 127.0.0.1 --port 3110",
    "build": "NEXT_TELEMETRY_DISABLED=1 WORKSPACE_PRODUCTION_BUILD=1 next build --webpack",
    "start": "NEXT_TELEMETRY_DISABLED=1 WORKSPACE_UI_ENABLED=1 WORKSPACE_PRODUCTION_BUILD=1 next start --hostname 127.0.0.1 --port 3110",
    "typecheck": "tsc --noEmit",
    "audit:graph": "node scripts/audit-graph.mjs"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@types/node": "22.17.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.2"
  }
}
