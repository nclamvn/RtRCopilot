      "provenance_fields": ["source_id", "source_version", "updated_at", "deleted_at", "checksum"],
      "cursor_field": "updated_at,id",
      "freshness_sla_seconds": 300,
      "budget": {"max_records_per_sync": 50000, "max_bytes_per_sync": 100000000, "max_requests_per_minute": 180}
    },
    {
      "stable_key": "rtr.ip",
