{
  "schema_version": 1,
  "connectors": [
    {
      "stable_key": "rtr.crm",
      "display_name": "RtR CRM authorized read model",
      "lifecycle": "contract_ready",
      "source_root": "crm",
      "owner_boundary": "Sales and account owner",
      "transport": "rest_api",
      "endpoint_env": "RTR_CRM_CONNECTOR_BASE_URL",
      "credential_env": "RTR_CRM_CONNECTOR_TOKEN",
      "read_only": true,
      "direct_database_access": false,
      "deletion_propagation": true,
      "classification": "restricted",
      "entity_scopes": ["company", "contact", "deal", "service_request"],
      "row_policy": "Account ownership and delegated sales scope are evaluated at source.",
      "field_policy": "Secrets, raw audit payloads, finance-only fields and deleted rows are excluded.",
      "purpose_limitation": "Internal account, pipeline and service assistance for authorized staff only.",
      "provenance_fields": ["source_id", "source_version", "updated_at", "deleted_at", "checksum"],
      "cursor_field": "updated_at,id",
      "freshness_sla_seconds": 900,
      "budget": {"max_records_per_sync": 10000, "max_bytes_per_sync": 50000000, "max_requests_per_minute": 120}
    },
    {
      "stable_key": "rtr.mrp",
