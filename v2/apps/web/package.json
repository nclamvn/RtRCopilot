  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@next/eslint-plugin-next": "16.2.11",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.17.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.11",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vitest": "3.2.6"
  }
