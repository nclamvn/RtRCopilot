"""Creator-owned real native filesystem. Opaque descriptors never export OS FDs."""

from __future__ import annotations

import ast
import hashlib
import json
import os
import posixpath
import stat
import threading
import uuid
from collections.abc import Callable, Iterator
from dataclasses import dataclass
from pathlib import Path
from types import FunctionType, SimpleNamespace
from typing import NoReturn, TypedDict, cast

import adapter
import bridge
import policy
import writer


def bind(function: object, namespace: dict[str, object]) -> Callable[..., object]:
    original = cast(FunctionType, function)
    value = FunctionType(original.__code__, namespace, original.__name__, original.__defaults__)
    value.__kwdefaults__ = original.__kwdefaults__
    return value


def limits(contract: object) -> dict[tuple[int, int], tuple[int, int]]:
    if contract != policy.wanted():
        raise adapter.PacketError("exact owned lifecycle codec policy")
    result = {(i, 1): (1, 0) for i in range(1, 21)}
    result[(19, 2)] = (1, 0)
    for family, variant, count, maximum in policy.DOMAINS.values():
        result[(adapter.IDS.index(family) + 1, variant)] = (count, maximum)
    if sum(n * (size + 11) for n, size in result.values()) + adapter.TERMINAL + adapter.CONTROLS > adapter.CAP:
        raise adapter.PacketError("coarse codec cap")
    return result


def semantic(owner: adapter.Writer, family: str, role: str) -> int:
    domain = policy.DOMAINS.get(role)
    if domain is None or domain[0] != family:
        owner.flags |= 1
        raise adapter.PacketError("owned lifecycle semantic role")
    return domain[1]


CODEC_GLOBALS: dict[str, object] = {**vars(adapter), "limits": limits, "semantic": semantic}


class PacketWriter(adapter.Writer):
    pass


def install_codec() -> None:
    policy.guard()
    tree = ast.parse(bridge.bounded(policy.REFERENCE / "adapter.py"))
    cls = next(n for n in tree.body if isinstance(n, ast.ClassDef) and n.name == "Writer")
    method = next(n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name == "emit")
    changes = 0
    for node in ast.walk(method):
        if isinstance(node, ast.Assign) and any(isinstance(t, ast.Name) and t.id == "subtype" for t in node.targets):
            node.value = ast.copy_location(ast.parse("semantic(self, family, variant)", mode="eval").body, node.value)
            changes += 1
    if changes != 1:
        raise adapter.PacketError("one pinned semantic AST delta")
    namespace = dict(CODEC_GLOBALS)
    exec(compile(ast.fix_missing_locations(ast.Module([method], [])), str(policy.REFERENCE / "adapter.py"), "exec"), namespace)
    for name, implementation in {"__init__": bind(adapter.Writer.__init__, CODEC_GLOBALS), "emit": namespace["emit"]}.items():
        setattr(PacketWriter, name, implementation)


install_codec()
PACKET_RECOVER = bind(adapter.recover, CODEC_GLOBALS)


@dataclass(frozen=True)
class Descriptor:
    epoch: str
    serial: int


@dataclass
class NativeFD:
    fd: int
    name: str
    directory: bool
    dev: int
    ino: int
    mode: int
    flags: int


class Frame(TypedDict):
    family: str
    variant: int
    seq: int
    role: str
    path: str
    mode: str
    requested: int


class Recovery(TypedDict):
    stage: str
    charge: int
    physical_attempt_bytes: int
    records: list[adapter.Record]
    events: list[dict[str, object]]
    artifacts: dict[str, dict[str, object]]
    actual_capture_admission: str


class Owner:
    def __init__(self, root: Path, faults: dict[str, tuple[str, bool]] | None = None) -> None:
        self.source = policy.guard()
        self.root = adapter.safe(root)
        self.thread = threading.get_ident()
        self.epoch = uuid.uuid4().hex
        self.virtual = "/r27-owned/" + self.epoch
        self.closed = False
        self.first_fault: BaseException | None = None
        self.faults = dict(faults or {})
        self.events: list[dict[str, object]] = []
        self.frames: list[Frame] = []
        self.artifacts: dict[str, dict[str, object]] = {}
        self.directories: set[str] = {""}
        self.lifetime_dirs: set[str] = {""}
        self.fds: dict[Descriptor, NativeFD] = {}
        self.serial = self.attempts = self.discovery = self.collisions = 0
        self.finalizers: list[object] = []
        self.synthetic_root: str | None = None
        self.synthetic_calls: dict[str, int] = {}
        self.observations: dict[str, dict[str, object]] = {}
        self.generation: dict[str, int] = {}
        self.permission_controls: set[str] = set()
        self.cleanup_errors: list[str] = []
        self.physical = 0
        self.charge = policy.META + adapter.TERMINAL + adapter.CONTROLS
        self.root.mkdir(mode=0o700)
        self.files = self.root / "files"
        self.files.mkdir(mode=0o700)
        contract, raw = policy.contract()
        self.packet = PacketWriter(self.root / "packet", contract, raw, policy.EPOCH)
        self.os = self.os_namespace()

    def fail(self, error: BaseException) -> NoReturn:
        if self.first_fault is None:
            self.first_fault = error
        self.packet.flags |= 1
        raise error

    def guard(self, *, cleanup: bool = False) -> None:
        if threading.get_ident() != self.thread or self.closed:
            raise adapter.PacketError("creator/live lifecycle epoch")
        if self.first_fault is not None and not cleanup:
            raise self.first_fault

    def name(self, path: object, directory: Descriptor | None = None) -> str:
        self.guard(cleanup=True)
        if isinstance(path, CapPath):
            if path.owner is not self:
                self.fail(adapter.PacketError("foreign path epoch"))
            value = path.name_value
        elif type(path) is str:
            text = cast(str, path)
            if text.startswith(self.virtual + "/"):
                value = text[len(self.virtual) + 1:]
            elif text == self.virtual:
                value = ""
            elif text in {"/tmp", "/var/tmp", "/usr/tmp"}:
                value = "candidates/" + text.strip("/").replace("/", "-")
            elif directory is not None and "/" not in text:
                value = posixpath.join(self.fd(directory).name, text)
            else:
                self.fail(adapter.PacketError("unowned native alias/path"))
        else:
            self.fail(adapter.PacketError("closed native path type"))
        if (value.startswith("/") or ".." in value.split("/") or posixpath.normpath(value or ".") != (value or ".")
                or len(value.encode()) > 256 or len(value.split("/")) > 8):
            self.fail(adapter.PacketError("finite canonical native name"))
        return value

    def path(self, value: object) -> CapPath:
        return CapPath(self, self.name(value))

    def target(self, name: str, *, follow: bool = False) -> Path:
        self.name(self.virtual + ("/" + name if name else ""))
        target = self.files / name
        for parent in target.parents:
            if parent == self.files.parent:
                break
            if parent.is_symlink():
                self.fail(adapter.PacketError("symlink parent traversal"))
        if target.is_symlink():
            item = self.artifacts.get(name)
            if item is None or item.get("kind") != "link" or os.readlink(target) != item["target"]:
                self.fail(adapter.PacketError("unowned native symlink"))
            resolved = posixpath.normpath(posixpath.join(posixpath.dirname(name), cast(str, item["target"])))
            if resolved.startswith("../") or resolved not in self.lifetime_dirs:
                self.fail(adapter.PacketError("external symlink target"))
            if follow:
                return self.files / resolved
        return target

    def metadata(self) -> dict[str, object]:
        return {"schema": "r27-owned-lifecycle-files-v1", "stage": "LOCAL_NATIVE_LIFECYCLE",
                "source": self.source, "contract_sha256": writer.digest(policy.contract()[1]),
                "artifacts": self.artifacts, "directories": sorted(self.directories),
                "lifetime_dirs": sorted(self.lifetime_dirs), "frames": self.frames,
                "events": self.events, "physical": self.physical, "charge": self.charge,
                "attempts": self.attempts, "observations": self.observations,
                "synthetic_root": self.synthetic_root, "synthetic_calls": self.synthetic_calls,
                "cleanup_errors": self.cleanup_errors,
                "finalizers_drained": all(not getattr(f, "alive") for f in self.finalizers)}

    def check_metadata(self) -> None:
        if (len(self.artifacts) > 32 or len(self.lifetime_dirs) > 48 or len(self.events) > 192
                or len(self.fds) > 16 or len(policy.canonical(self.metadata())) + 4096 > policy.META):
            self.fail(adapter.PacketError("pre-I/O metadata/close reserve domain"))

    def headroom(self) -> int:
        dirs = sum(n.startswith(("candidates/", "pytest-base/", "controls/")) for n in self.directories)
        files = sum(bool(a["exists"]) and n.startswith(("candidates/", "pytest-base/", "controls/")) for n, a in self.artifacts.items())
        return 4 * dirs + files + len(self.fds) + 4

    def tick(self, *, cleanup: bool = False, cost: int = 1) -> None:
        self.guard(cleanup=cleanup)
        reserve = 0 if cleanup else self.headroom()
        if self.attempts + cost + reserve > 512 or len(self.events) + reserve + 1 > 192:
            self.fail(adapter.PacketError("finite operation/event/cleanup reserve"))
        self.attempts += cost

    def event(self, op: str, name: str, action: Callable[[], object], *, args: object = None,
              cleanup: bool = False, recoverable: bool = False, frame: Frame | None = None) -> object:
        self.tick(cleanup=cleanup)
        value: dict[str, object] = {"op": op, "path": name, "args": args, "ordinal": self.attempts,
                                   "result": None, "error": "!" * 1024, "injected": False,
                                   "frame": list((frame["family"], frame["variant"], frame["seq"])) if frame else None}
        self.events.append(value)
        self.check_metadata()
        value["error"] = None
        try:
            fault = self.faults.pop(op, None)
            if fault is not None and fault[0] != "short":
                value["injected"] = True
                error = PermissionError("injected " + op) if fault[0] == "permission" else OSError("injected " + op)
                if not fault[1]:
                    self.first_fault = self.first_fault or error
                    self.packet.flags |= 1
                raise error
            value["short_control"] = fault is not None
            result = action()
            value["result"] = result if isinstance(result, (str, int, bool, list, dict, type(None))) else "native-object"
            return result
        except BaseException as error:
            text = str(error)
            value["error"] = {"type": type(error).__name__, "text": text}
            if len(text.encode()) > 1024:
                self.first_fault = self.first_fault or error
                self.packet.flags |= 1
                raise
            declared = (value["injected"] and fault is not None and fault[1]) or (
                recoverable and (
                    isinstance(error, FileExistsError) and op in {"mkdir", "open"}
                    or isinstance(error, FileNotFoundError) and op in {"unlink", "rmdir"}
                    or isinstance(error, PermissionError) and name in self.permission_controls
                )
            )
            value["recoverable"] = declared
            if not declared:
                self.first_fault = self.first_fault or error
                self.packet.flags |= 1
            raise

    def observe(self, kind: str, name: str, action: Callable[[], os.stat_result], *, token: int | None = None) -> os.stat_result:
        self.tick(cleanup=True)
        key = str((kind, name, self.generation.get(name, 0), token))
        item = self.observations.setdefault(key, {"kind": kind, "path": name, "generation": self.generation.get(name, 0), "token": token, "count": 0, "first": self.attempts, "last": self.attempts, "result": None, "error": None})
        item["count"] = cast(int, item["count"]) + 1
        item["last"] = self.attempts
        self.check_metadata()
        try:
            info = action()
            result = [info.st_dev, info.st_ino, info.st_mode, info.st_size, getattr(info, "st_flags", 0)]
            if item["result"] not in (None, result):
                self.fail(adapter.PacketError("native observation identity changed without owned action"))
            item["result"] = result
            return info
        except FileNotFoundError as error:
            item["error"] = {"type": "FileNotFoundError", "text": str(error)}
            self.check_metadata()
            raise
        except BaseException as error:
            item["error"] = {"type": type(error).__name__, "text": str(error)}
            self.fail(error)

    def bump(self, name: str) -> None:
        self.generation[name] = self.generation.get(name, 0) + 1

    def register(self, name: str, kind: str) -> None:
        if name not in self.artifacts:
            self.artifacts[name] = {"kind": kind, "exists": False}
        elif self.artifacts[name]["kind"] != kind:
            self.fail(adapter.PacketError("immutable native role kind"))
        self.check_metadata()

    def raw(self, role: str, name: str, raw: bytes, mode: str) -> Frame:
        self.guard()
        if type(raw) is not bytes or role not in policy.DOMAINS:
            self.fail(adapter.PacketError("exact raw owned domain"))
        family, variant, _, maximum = policy.DOMAINS[role]
        if len(raw) > maximum:
            self.fail(adapter.PacketError("whole native payload maximum"))
        if role == "synthetic_input":
            if self.synthetic_root is None:
                self.fail(adapter.PacketError("original setup root required"))
            relative = name.removeprefix(self.synthetic_root + "/")
            bound = policy.SYNTHETIC.get(relative)
            if bound is None or len(raw) > bound[1] or self.synthetic_calls.get(relative, 0) >= bound[0]:
                self.fail(adapter.PacketError("original whole source path/count"))
            self.synthetic_calls[relative] = self.synthetic_calls.get(relative, 0) + 1
        seq = self.packet.next.get((adapter.IDS.index(family) + 1, variant), 0)
        frame: Frame = {"family": family, "variant": variant, "seq": seq, "role": role,
                        "path": name, "mode": mode, "requested": len(raw)}
        self.register(name, "link" if role == "owned_link" else "file")
        self.frames.append(frame)
        self.check_metadata()
        amount = 2 * len(raw) + 11
        if self.charge + amount + 91 > adapter.CAP:
            self.fail(adapter.PacketError("same shared prewrite cap"))
        self.charge += amount
        self.physical += len(raw)
        try:
            self.packet.emit(family, role, raw)
        except BaseException as error:
            self.fail(error)
        return frame

    def role(self, name: str) -> str:
        if self.synthetic_root and name.startswith(self.synthetic_root + "/"):
            return "synthetic_input"
        if name in {"reports/stdout.txt", "reports/stderr.txt"}:
            return "stream"
        if name.startswith("reports/warning-"):
            return "warning"
        if name == "reports/result.xml":
            return "pytest_xml"
        if name.startswith(("candidates/", "pytest-base/", "controls/")):
            return "native_small"
        self.fail(adapter.PacketError("undeclared native output role"))

    def fd(self, token: object) -> NativeFD:
        if not isinstance(token, Descriptor) or token.epoch != self.epoch or token not in self.fds:
            self.fail(adapter.PacketError("opaque live owned descriptor"))
        return self.fds[token]

    def native_arg(self, name: str, directory: Descriptor | None) -> tuple[object, dict[str, int]]:
        self.target(name)
        if directory is None:
            return self.target(name), {}
        fd = self.fd(directory)
        if not fd.directory or posixpath.dirname(name) != fd.name:
            self.fail(adapter.PacketError("exact descriptor-relative child"))
        return posixpath.basename(name), {"dir_fd": fd.fd}

    def open(self, path: object, flags: int, mode: int = 0o777, *, dir_fd: Descriptor | None = None,
             empty: bool = True, frame: Frame | None = None) -> Descriptor:
        name = self.name(path, dir_fd)
        self.guard()
        if len(self.fds) >= 16 or type(flags) is not int or flags & ~(os.O_RDWR | os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_TRUNC | os.O_NONBLOCK | os.O_NOFOLLOW):
            self.fail(adapter.PacketError("finite native open flags/fd"))
        creating = bool(flags & os.O_CREAT)
        if creating and name.startswith("candidates/") and empty:
            self.discovery += 1
            if self.discovery > 32:
                self.fail(adapter.PacketError("finite genuine discovery attempts"))
        if creating and empty:
            frame = self.raw("native_small", name, b"", "create")
        target = self.target(name, follow=not creating)
        native_arg, native_kw = self.native_arg(name, dir_fd)
        def action() -> object:
            descriptor = os.open(native_arg, flags | (os.O_NOFOLLOW if creating else 0), mode, **native_kw)
            self.serial += 1
            token = Descriptor(self.epoch, self.serial)
            self.fds[token] = NativeFD(descriptor, name, False, -1, -1, 0, flags)
            info = os.fstat(descriptor)
            self.fds[token] = NativeFD(descriptor, name, stat.S_ISDIR(info.st_mode), info.st_dev, info.st_ino, info.st_mode, flags)
            if creating:
                self.artifacts[name]["exists"] = True
                self.bump(name)
            return {"token": self.serial, "dev": info.st_dev, "ino": info.st_ino,
                    "mode": info.st_mode, "directory": stat.S_ISDIR(info.st_mode)}
        self.event("open", name, action, args=[flags, mode], recoverable=creating and empty, frame=frame)
        return Descriptor(self.epoch, self.serial)

    def write(self, token: object, raw: bytes, *, frame: Frame | None = None) -> int:
        fd = self.fd(token)
        if fd.directory or type(raw) is not bytes:
            self.fail(adapter.PacketError("exact file write capability"))
        if frame is None:
            frame = self.raw("native_small", fd.name, raw, "a")
        short = self.faults.get("write") == ("short", False)
        def action() -> object:
            return os.write(fd.fd, raw[:1] if short else raw)
        returned = cast(int, self.event("write", fd.name, action, args=cast(Descriptor, token).serial, frame=frame))
        self.bump(fd.name)
        if returned != len(raw):
            error = OSError("actual short native write")
            self.first_fault = self.first_fault or error
            self.packet.flags |= 1
        return returned

    def close(self, token: object) -> None:
        fd = self.fd(token)
        self.event("close", fd.name, lambda: os.close(fd.fd), args=cast(Descriptor, token).serial, cleanup=True)
        del self.fds[cast(Descriptor, token)]

    def whole(self, name: str, raw: bytes, *, role: str | None = None) -> int:
        self.name(self.virtual + "/" + name)
        frame = self.raw(role or self.role(name), name, raw, "w")
        steps: dict[str, object] = {}
        def action() -> object:
            fd = os.open(self.target(name), os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
            self.serial += 1
            token = Descriptor(self.epoch, self.serial)
            self.fds[token] = NativeFD(fd, name, False, -1, -1, 0, os.O_WRONLY | os.O_CREAT | os.O_TRUNC)
            try:
                info = os.fstat(fd)
                steps["opened"] = [info.st_dev, info.st_ino, info.st_mode]
                self.fds[token] = NativeFD(fd, name, False, info.st_dev, info.st_ino, info.st_mode, os.O_WRONLY | os.O_CREAT | os.O_TRUNC)
                self.artifacts[name]["exists"] = True
                returned = os.write(fd, raw)
                steps["written"] = returned
                self.bump(name)
                if returned != len(raw):
                    self.fail(OSError("actual short whole native write"))
                return returned
            finally:
                os.close(fd)
                steps["closed"] = True
                del self.fds[token]
        return cast(int, self.event("whole", name, action, args=steps, frame=frame))

    def mkdir(self, path: object, mode: int = 0o777, *, exist_ok: bool = False) -> None:
        name = self.name(path)
        self.guard()
        if name not in self.lifetime_dirs:
            self.lifetime_dirs.add(name)
        if posixpath.basename(name).startswith("codex-tmp-r21-controls-"):
            self.collisions += 1
            if self.collisions > 32:
                self.fail(adapter.PacketError("finite source mkdir collision attempts"))
        self.check_metadata()
        def action() -> object:
            try:
                self.target(name).mkdir(mode=mode)
            except FileExistsError:
                if not exist_ok:
                    raise
            self.directories.add(name)
            self.bump(name)
            return stat.S_IMODE(self.target(name).stat().st_mode)
        self.event("mkdir", name, action, args=[mode, exist_ok], recoverable=True)
        if posixpath.basename(name).startswith("codex-tmp-r21-controls-") and self.target(name).is_dir():
            self.synthetic_root = name

    def unlink(self, path: object, *, dir_fd: Descriptor | None = None) -> None:
        name = self.name(path, dir_fd)
        native_arg, native_kw = self.native_arg(name, dir_fd)
        def action() -> object:
            os.unlink(native_arg, **native_kw)
            if name in self.artifacts:
                self.artifacts[name]["exists"] = False
            self.bump(name)
            return None
        self.event("unlink", name, action, cleanup=True, recoverable=True)

    def rmdir(self, path: object, *, dir_fd: Descriptor | None = None) -> None:
        name = self.name(path, dir_fd)
        if not name or name not in self.lifetime_dirs:
            self.fail(adapter.PacketError("closed directory removal"))
        native_arg, native_kw = self.native_arg(name, dir_fd)
        def action() -> object:
            os.rmdir(native_arg, **native_kw)
            self.directories.discard(name)
            self.bump(name)
            return None
        self.event("rmdir", name, action, cleanup=True, recoverable=True)

    def change(self, op: str, path: object, value: int, *, follow_symlinks: bool = True) -> None:
        name = self.name(path)
        native_mode = self.info(path, follow_symlinks=follow_symlinks).st_mode
        if op not in {"chmod", "chflags"} or value not in {0, 0o400, 0o500, 0o600, 0o700, native_mode | stat.S_IRUSR | stat.S_IWUSR}:
            self.fail(adapter.PacketError("closed permission control"))
        function = os.chmod if op == "chmod" else os.chflags
        def action() -> object:
            function(self.target(name), value, follow_symlinks=follow_symlinks)
            self.bump(name)
            info = os.stat(self.target(name), follow_symlinks=follow_symlinks)
            if op == "chmod" and stat.S_IMODE(info.st_mode) in {0o400, 0o500}:
                self.permission_controls.add(name)
            return [info.st_dev, info.st_ino, info.st_mode, getattr(info, "st_flags", 0)]
        self.event(op, name, action, args=[value, follow_symlinks], cleanup=True)

    def symlink(self, path: object, target: object) -> None:
        name, destination = self.name(path), self.name(target)
        if not name.startswith("pytest-base/") or not name.endswith("current") or destination not in self.lifetime_dirs:
            self.fail(adapter.PacketError("only owned pytest current links"))
        relative = posixpath.relpath(destination, posixpath.dirname(name))
        frame = self.raw("owned_link", name, relative.encode(), "symlink")
        self.artifacts[name]["target"] = relative
        def action() -> object:
            os.symlink(relative, self.target(name))
            self.artifacts[name]["exists"] = True
            self.bump(name)
            return relative
        self.event("symlink", name, action, args=str(target), frame=frame)

    def info(self, path: object, *, dir_fd: Descriptor | None = None, follow_symlinks: bool = True) -> os.stat_result:
        name = self.name(path, dir_fd)
        native_arg, native_kw = self.native_arg(name, dir_fd)
        return self.observe("stat" if follow_symlinks else "lstat", name, lambda: os.stat(native_arg, follow_symlinks=follow_symlinks, **native_kw))

    def fstat(self, token: object) -> os.stat_result:
        fd = self.fd(token)
        info = self.observe("fstat", fd.name, lambda: os.fstat(fd.fd), token=cast(Descriptor, token).serial)
        if fd.dev != -1 and (info.st_dev, info.st_ino) != (fd.dev, fd.ino):
            self.fail(adapter.PacketError("owned descriptor inode changed"))
        return info

    def scandir(self, path: object) -> Scan:
        if isinstance(path, Descriptor):
            fd = self.fd(path)
            name, native_arg = fd.name, fd.fd
        else:
            name = self.name(path)
            native_arg = self.target(name)
        def action() -> object:
            with os.scandir(native_arg) as entries:
                values = list(entries)
            if len(values) > 32:
                self.fail(adapter.PacketError("finite owned scandir"))
            known = self.lifetime_dirs | set(self.artifacts)
            if any(posixpath.join(name, e.name) not in known for e in values):
                self.fail(adapter.PacketError("unowned native member"))
            return values
        entries = cast(list[os.DirEntry[str]], self.event("scandir", name, action, cleanup=True))
        self.events[-1]["result"] = [e.name for e in entries]
        return Scan([Entry(self, name, e) for e in entries])

    def audit(self, event: str, *args: object) -> None:
        if event not in {"tempfile.mkdtemp", "shutil.rmtree"}:
            self.fail(adapter.PacketError("closed genuine audit code point"))
        self.event("audit", self.name(args[0]), lambda: None, args=event, cleanup=event == "shutil.rmtree")

    def warning(self, message: object, category: object = UserWarning, **kwargs: object) -> None:
        text = str(message)
        self.event("warning", "", lambda: None, args=[getattr(category, "__name__", str(category)), text], cleanup=True)
        if self.first_fault is None:
            self.whole("reports/warning-" + str(sum(f["role"] == "warning" for f in self.frames)) + ".txt", text.encode(), role="warning")

    def os_namespace(self) -> SimpleNamespace:
        path = SimpleNamespace(**{n: getattr(posixpath, n) for n in ("join", "dirname", "basename", "normpath", "normcase", "isabs", "splitdrive", "samestat")})
        path.abspath = lambda p: str(self.path(p))
        path.isdir = lambda p: self.path(p).is_dir()
        path.islink = lambda p: self.path(p).is_symlink()
        path.exists = lambda p: self.path(p).exists()
        path.isjunction = lambda p: False
        path.expanduser = lambda p: p
        path.expandvars = lambda p: p
        chmod = lambda p, m, **k: self.change("chmod", p, m, **k)
        chflags = lambda p, m, **k: self.change("chflags", p, m, **k)
        result = SimpleNamespace(**{n: getattr(os, n) for n in ("name", "O_RDONLY", "O_RDWR", "O_WRONLY", "O_CREAT", "O_EXCL", "O_TRUNC", "O_NONBLOCK", "O_NOFOLLOW", "getpid", "fsencode", "fsdecode", "PathLike", "sep", "altsep", "curdir", "pardir")})
        result.__dict__.update(path=path, open=self.open, write=self.write, close=self.close,
                               mkdir=self.mkdir, unlink=self.unlink, remove=self.unlink, rmdir=self.rmdir,
                               lstat=lambda p, **k: self.info(p, follow_symlinks=False, **k), stat=self.info,
                               fstat=self.fstat, scandir=self.scandir,
                               chmod=chmod, chflags=chflags, getcwd=lambda: self.virtual + "/candidates/cwd",
                               getenv=lambda key: self.virtual + "/candidates/TMPDIR" if key == "TMPDIR" else None,
                               environ={"TMPDIR": self.virtual + "/candidates/TMPDIR"})
        result.supports_follow_symlinks = {result.stat, chmod, chflags}
        result.supports_dir_fd = {result.open, result.stat, result.unlink, result.rmdir}
        result.supports_fd = {result.scandir}
        return result

    def prepare(self) -> None:
        for name in ("reports", "candidates", "candidates/TMPDIR", "candidates/tmp", "candidates/var-tmp", "candidates/usr-tmp", "candidates/cwd", "controls", "pytest-base"):
            self.mkdir(CapPath(self, name), 0o700)

    def drain(self) -> None:
        for token in list(self.fds):
            try:
                self.close(token)
            except BaseException as error:
                self.cleanup_errors.append(str(error))
                self.close(token)
        for finalizer in self.finalizers:
            if getattr(finalizer, "alive"):
                cast(Callable[[], object], finalizer)()

    def finish(self) -> Recovery:
        self.guard()
        if self.fds or any(getattr(f, "alive") for f in self.finalizers) or policy.guard() != self.source:
            self.fail(adapter.PacketError("joined descriptors/finalizers/source epoch"))
        manifest = self.metadata()
        raw = policy.canonical(manifest)
        self.check_metadata()
        if self.charge + 91 > adapter.CAP:
            self.fail(adapter.PacketError("closure capacity"))
        with (self.root / "manifest.json").open("xb", buffering=0) as file:
            if file.write(raw) != len(raw):
                self.fail(OSError("short lifecycle metadata write"))
            os.fsync(file.fileno())
        self.charge += 91
        self.packet.emit("source_cap_child", "closure", b"BROKER-MANIFEST:" + writer.digest(raw).encode())
        for family in adapter.IDS:
            self.packet.close_family(family)
        self.packet.finish()
        self.closed = True
        return recover(self.root)

    def abandon(self) -> None:
        self.drain()
        self.packet.abandon()
        self.closed = True


class Entry:
    def __init__(self, owner: Owner, parent: str, entry: os.DirEntry[str]) -> None:
        self.owner, self.entry = owner, entry
        self.name = entry.name
        self.path = owner.virtual + "/" + posixpath.join(parent, entry.name)

    def is_dir(self, *, follow_symlinks: bool = True) -> bool:
        return stat.S_ISDIR(self.stat(follow_symlinks=follow_symlinks).st_mode)

    def stat(self, *, follow_symlinks: bool = True) -> os.stat_result:
        name = self.owner.name(self.path)
        self.owner.target(name, follow=follow_symlinks)
        return self.owner.observe("entry_stat", name, lambda: self.entry.stat(follow_symlinks=follow_symlinks))


class Scan:
    def __init__(self, entries: list[Entry]) -> None:
        self.entries = entries

    def __iter__(self) -> Iterator[Entry]:
        return iter(self.entries)

    def __enter__(self) -> Scan:
        return self

    def __exit__(self, *args: object) -> None:
        pass


class CapPath:
    def __init__(self, owner: Owner, name: str) -> None:
        self.owner, self.name_value = owner, owner.name(owner.virtual + ("/" + name if name else ""))

    def __str__(self) -> str:
        return self.owner.virtual + ("/" + self.name_value if self.name_value else "")

    def __fspath__(self) -> NoReturn:
        self.owner.fail(TypeError("no native pathname export"))

    def __eq__(self, other: object) -> bool:
        return isinstance(other, CapPath) and self.owner is other.owner and self.name_value == other.name_value

    def __truediv__(self, child: str) -> CapPath:
        if type(child) is not str or child.startswith("/") or ".." in child.split("/"):
            self.owner.fail(adapter.PacketError("closed relative child"))
        name = posixpath.normpath(posixpath.join(self.name_value, child))
        return self.owner.path(self.owner.virtual + "/" + name)

    def joinpath(self, child: str) -> CapPath:
        return self / child

    @property
    def parent(self) -> CapPath:
        return CapPath(self.owner, posixpath.dirname(self.name_value))

    @property
    def parents(self) -> tuple[CapPath, ...]:
        values: list[CapPath] = []
        parent = self.parent
        while parent.name_value:
            values.append(parent)
            parent = parent.parent
        return tuple(values)

    @property
    def name(self) -> str:
        return posixpath.basename(self.name_value)

    def with_name(self, name: str) -> CapPath:
        return self.parent / name

    def resolve(self, strict: bool = False) -> CapPath:
        if self.is_symlink():
            entry = self.owner.artifacts[self.name_value]
            name = posixpath.normpath(posixpath.join(posixpath.dirname(self.name_value), cast(str, entry["target"])))
            result = CapPath(self.owner, name)
        else:
            result = self
        if strict and not result.exists():
            raise FileNotFoundError(str(result))
        return result

    def exists(self) -> bool:
        try:
            self.owner.info(self)
        except FileNotFoundError:
            return False
        return True

    def is_dir(self) -> bool:
        try:
            return stat.S_ISDIR(self.owner.info(self).st_mode)
        except FileNotFoundError:
            return False

    def is_file(self) -> bool:
        try:
            return stat.S_ISREG(self.owner.info(self).st_mode)
        except FileNotFoundError:
            return False

    def is_symlink(self) -> bool:
        try:
            return stat.S_ISLNK(self.owner.info(self, follow_symlinks=False).st_mode)
        except FileNotFoundError:
            return False

    def stat(self) -> os.stat_result:
        return self.owner.info(self)

    def mkdir(self, mode: int = 0o777, parents: bool = False, exist_ok: bool = False) -> None:
        if parents:
            for parent in reversed(self.parents):
                if not parent.exists():
                    parent.mkdir(mode=mode, exist_ok=True)
        self.owner.mkdir(self, mode, exist_ok=exist_ok)

    def unlink(self, missing_ok: bool = False) -> None:
        if missing_ok and not self.exists() and not self.is_symlink():
            return
        self.owner.unlink(self)

    def rmdir(self) -> None:
        self.owner.rmdir(self)

    def symlink_to(self, target: object) -> None:
        self.owner.symlink(self, target)

    def iterdir(self) -> Iterator[CapPath]:
        return iter([self / e.name for e in self.owner.scandir(self)])

    def read_bytes(self) -> bytes:
        self.owner.guard()
        self.owner.info(self)
        target = self.owner.target(self.name_value, follow=True)
        if not target.exists():
            raise FileNotFoundError(str(self))
        return writer.bounded_read(target, adapter.CAP)

    def write_bytes(self, raw: bytes) -> int:
        return self.owner.whole(self.name_value, raw)

    def write_text(self, text: str, encoding: str = "utf-8") -> int:
        if type(text) is not str or encoding != "utf-8":
            self.owner.fail(TypeError("whole UTF8 source input"))
        self.write_bytes(text.encode())
        return len(text)


def recover(root: Path) -> Recovery:
    policy.guard()
    root = adapter.safe(root)
    if set(p.name for p in root.iterdir()) != {"files", "packet", "manifest.json"}:
        raise adapter.PacketError("owned lifecycle layout")
    raw = writer.bounded_read(root / "manifest.json", policy.META)
    manifest = writer.mapping(json.loads(raw))
    if (policy.canonical(manifest) != raw or manifest.get("stage") != "LOCAL_NATIVE_LIFECYCLE"
            or manifest.get("source") != policy.guard() or manifest.get("contract_sha256") != writer.digest(policy.contract()[1])):
        raise adapter.PacketError("lifecycle stage/source/contract")
    packet = writer.mapping(PACKET_RECOVER(root / "packet", policy.wanted(), policy.contract()[1], policy.EPOCH))
    records = cast(list[adapter.Record], packet["records"])
    if records[-1][0:3] != ("source_cap_child", 1, 0) or records[-1][3] != b"BROKER-MANIFEST:" + writer.digest(raw).encode():
        raise adapter.PacketError("owned metadata closure marker")
    frames = cast(list[Frame], manifest["frames"])
    events = cast(list[dict[str, object]], manifest["events"])
    artifacts = writer.mapping(manifest["artifacts"])
    if len(frames) > 70 or len(events) > 192 or len(artifacts) > 32 or len(cast(list[str], manifest["lifetime_dirs"])) > 48 or manifest.get("finalizers_drained") is not True:
        raise adapter.PacketError("recovery finite lifecycle domains")
    payloads = {(f, v, s): p for f, v, s, p in records[:-1]}
    keys = [(f["family"], f["variant"], f["seq"]) for f in frames]
    if len(set(keys)) != len(keys) or set(keys) != set(payloads):
        raise adapter.PacketError("every raw frame exactly one owner")
    physical = 0
    expected: dict[str, bytes] = {}
    live_dirs = {""}
    descriptor_ids: dict[int, tuple[int, int]] = {}
    applied: set[tuple[str, int, int]] = set()
    for index, event in enumerate(events, 1):
        if event.get("ordinal") != index or type(event.get("path")) is not str:
            raise adapter.PacketError("ordered native event history")
        name = cast(str, event["path"])
        if name.startswith("/") or ".." in name.split("/") or len(name.encode()) > 256:
            raise adapter.PacketError("recovery canonical name")
        op, result, error = event["op"], event["result"], event["error"]
        frame_value = event.get("frame")
        frame_key = cast(tuple[str, int, int], tuple(frame_value)) if isinstance(frame_value, list) else None
        if frame_key is not None:
            if frame_key not in payloads:
                raise adapter.PacketError("missing raw native event input")
            frame = frames[keys.index(frame_key)]
            if frame["path"] != name or frame["requested"] != len(payloads[frame_key]) or frame["role"] not in policy.DOMAINS or policy.DOMAINS[frame["role"]][:2] != frame_key[:2]:
                raise adapter.PacketError("typed frame role/path/size")
        if error is not None:
            if event.get("recoverable") is not True:
                raise adapter.PacketError("terminal native fault cannot seal")
            continue
        if op == "mkdir":
            if posixpath.dirname(name) not in live_dirs:
                raise adapter.PacketError("mkdir parent replay")
            live_dirs.add(name)
        elif op == "open":
            values = writer.mapping(result)
            ident = writer.integer(values["token"])
            if ident in descriptor_ids or len(descriptor_ids) >= 16:
                raise adapter.PacketError("native descriptor generation")
            descriptor_ids[ident] = (writer.integer(values["dev"]), writer.integer(values["ino"]))
            flags = cast(list[int], event["args"])[0]
            if flags & os.O_CREAT:
                if posixpath.dirname(name) not in live_dirs:
                    raise adapter.PacketError("file create parent")
                if flags & os.O_TRUNC or name not in expected:
                    expected[name] = b""
                if frame_key is not None and payloads[frame_key] == b"":
                    applied.add(frame_key)
        elif op == "write":
            if frame_key is None or writer.integer(result) != len(payloads[frame_key]) or writer.integer(event["args"]) not in descriptor_ids:
                raise adapter.PacketError("requested/actual native bytes")
            if frame_key in applied or name not in expected:
                raise adapter.PacketError("one actual raw write")
            expected[name] += payloads[frame_key]
            applied.add(frame_key)
        elif op == "close":
            if writer.integer(event["args"]) not in descriptor_ids:
                raise adapter.PacketError("exact descriptor finally close")
            del descriptor_ids[writer.integer(event["args"])]
        elif op == "symlink":
            if frame_key is None or name in expected or posixpath.dirname(name) not in live_dirs or payloads[frame_key] != cast(str, result).encode():
                raise adapter.PacketError("owned raw link target")
            expected[name] = payloads[frame_key]
            applied.add(frame_key)
        elif op == "unlink":
            if name not in expected:
                raise adapter.PacketError("delete live artifact")
            del expected[name]
        elif op == "rmdir":
            if name not in live_dirs or any(p.startswith(name + "/") for p in (*live_dirs, *expected)):
                raise adapter.PacketError("directory final-state replay")
            live_dirs.remove(name)
        elif op not in {"scandir", "chmod", "chflags", "audit", "warning"}:
            raise adapter.PacketError("unknown native event")
    if descriptor_ids or applied != set(payloads) or live_dirs != set(cast(list[str], manifest["directories"])):
        raise adapter.PacketError("complete native descriptor/frame/directory conservation")
    for frame in frames:
        physical += len(payloads[(frame["family"], frame["variant"], frame["seq"])])
    actual_files: set[str] = set()
    actual_dirs = {""}
    for parent, dirs, files in os.walk(root / "files", followlinks=False):
        for name in [*dirs, *files]:
            path = Path(parent) / name
            relative = path.relative_to(root / "files").as_posix()
            info = path.lstat()
            if stat.S_ISDIR(info.st_mode):
                actual_dirs.add(relative)
            elif stat.S_ISLNK(info.st_mode):
                actual_files.add(relative)
                if relative not in expected or os.readlink(path).encode() != expected[relative]:
                    raise adapter.PacketError("native symlink byte conservation")
            elif stat.S_ISREG(info.st_mode):
                actual_files.add(relative)
                if relative not in expected or writer.bounded_read(path, len(expected[relative])) != expected[relative]:
                    raise adapter.PacketError("native file byte conservation")
            else:
                raise adapter.PacketError("nonregular owned native artifact")
    if actual_files != set(expected) or actual_dirs != live_dirs:
        raise adapter.PacketError("missing/extra owned native artifact")
    charge = sum(len(p) + 11 for _, _, _, p in records) + physical + policy.META + adapter.TERMINAL + adapter.CONTROLS
    if physical != manifest["physical"] or charge != writer.integer(manifest["charge"]) + 91 or charge > adapter.CAP:
        raise adapter.PacketError("shared no-refund physical/frame accounting")

